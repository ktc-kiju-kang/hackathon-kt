# cp .env.example .env  (.env는 커밋 금지)
CORS_ORIGINS=http://localhost:3000
# PostgreSQL. 비우면 postgresql://app:app@localhost:55432/app (make db / docker compose의 db)
# docker로 실행할 때(make dev·serve)는 compose.yaml이 db 주소를 넣으므로 이 값은 NATIVE=1·테스트에만 쓰인다
DATABASE_URL=
LLM_EFFORT=medium       # low | medium | high
# AI 에이전트. 키가 하나도 없으면 mock LLM(키 없이 개발·시험 가능)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=           # 비우면 자동 (anthropic > gemini > mock), 강제: anthropic | gemini | openai | mock
LLM_MODEL=              # 비우면 기본값 (claude-opus-5-5 / gemini-3.8-flash)
# OpenAI 호환 API: LLM_PROVIDER=openai + LLM_BASE_URL + LLM_MODEL + LLM_API_KEY
LLM_BASE_URL=
LLM_API_KEY=
# 현황판(/dashboard) GitHub 칸 — docs/contracts/dashboard.md
GITHUB_REPO=            # owner/name. 비우면 git origin 주소에서
GITHUB_TOKEN=           # 비밀! 읽기 전용 토큰 (공개 github.com 레포는 없어도 됨, 시간당 60회)
GITHUB_API_URL=         # 비우면 github.com, 사내 GHE는 origin 호스트의 /api/v3
