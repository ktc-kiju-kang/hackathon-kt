# 콤마 구분. 로컬 Next.js + 배포 도메인 (Vercel 프리뷰는 CORS_ORIGIN_REGEX로 허용)
CORS_ORIGINS=https://hackathon-kt.vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://hackathon-[a-z0-9-]+-ktc-kiju-kang\.vercel\.app
# Supabase 대시보드 > Project Settings > API (service_role 키는 비밀!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AI 에이전트. 키 하나만 넣으면 자동 선택 (ANTHROPIC > GEMINI), 둘 다 없으면 mock LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=         # 무료: aistudio.google.com → Get API key
LLM_PROVIDER=           # 비우면 자동 (anthropic | gemini | openai | mock)
LLM_MODEL=              # 비우면 기본값 (claude-opus-5-5 / gemini-3.8-flash)
# OpenAI 호환 API (Groq, GitHub Models, OpenRouter, Ollama 등): LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_EFFORT=medium
