# 환경변수 목록 (참고용). 실제 값은 각 앱 폴더의 .env 에 둔다. .env 는 커밋 금지.

# --- frontend/.env.local (cp frontend/.env.example frontend/.env.local) ---
# 브라우저에 노출됨. 비밀값 금지.
NEXT_PUBLIC_API_BASE_URL=            # 비우면 mock. 로컬 백엔드: http://localhost:8000

# --- backend/.env (cp backend/.env.example backend/.env) ---
CORS_ORIGINS=https://hackathon-kt.vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://hackathon-[a-z0-9-]+-ktc-kiju-kang\.vercel\.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # 비밀! 레포·프론트·채팅에 붙여넣지 말 것
ANTHROPIC_API_KEY=                   # 비밀! 없으면 에이전트가 mock LLM으로 동작
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
