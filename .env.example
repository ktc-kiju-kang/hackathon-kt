# 환경변수 목록 (참고용). 실제 값은 frontend/.env.local, backend/.env 에 둔다. 커밋 금지.
# 자세한 설명: frontend/.env.example, backend/.env.example
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # frontend — 브라우저에 노출됨, 비밀값 금지
CORS_ORIGINS=http://localhost:3000               # backend
DATABASE_URL=                                    # backend — 비우면 postgresql://app:app@localhost:55432/app (docker compose db)
ANTHROPIC_API_KEY=                               # backend — 비밀! 없으면 mock LLM
GITHUB_TOKEN=                                    # backend — 비밀! 현황판 GitHub 칸 (공개 레포는 없어도 됨)
LLM_PROVIDER=
